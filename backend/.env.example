# Database Connection (MS SQL Server)
# Format: mssql+pyodbc://<username>:<password>@<host>:<port>/<db_name>?driver=ODBC+Driver+17+for+SQL+Server
# For local SQL Express using Windows Auth: mssql+pyodbc://@localhost/JharkhandBijliDB?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
DATABASE_URL=mssql+pyodbc://sa:YourSecurePassword123@localhost:1433/JharkhandBijliDB?driver=ODBC+Driver+17+for+SQL+Server

# Security Configuration
SECRET_KEY=e9a117b3ff4e44b8b60f15cde20cb4570dbce5db6dbd6c6e7a2b9195b0586cc8
ACCESS_TOKEN_EXPIRE_MINUTES=480

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key

# File Upload Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=20

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173
